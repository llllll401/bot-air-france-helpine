# Token du bot - https://discord.com/developers/applications
DISCORD_TOKEN=ton_token_ici

# IDs (déjà configurés par défaut, tu peux les override)
GUILD_ID=1553129363858530465
TICKET_CATEGORY_ID=1560529185880154263
STAFF_ROLE_ID=1564261898935992382

# Optionnels
LOG_CHANNEL_ID=
ANNOUNCE_CHANNEL_ID=
